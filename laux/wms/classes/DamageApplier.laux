public class DamageApplier

    constructor(damage: Damage)
        self.damage = damage
    end

    apply()

        if WMS.config.NO_DMG then return end

        self:handleDeath()
        self:handleComa()
        self:handleDamage()
        self:handleBleeding()
        self:handleBrokenLimb()
        self:handleExplosion()

    end

    handleComa()

        if self.damage.postVictimState != WMS.enums.lifeStates.PARTIAL_DEATH then 
            return 
        end

        self.damage.victim:wmsStartComa()

    end

    handleDeath()

        if self.damage.postVictimState != WMS.enums.lifeStates.TOTAL_DEATH then 
            return 
        end

        self.damage.victim:wmsKill()

    end

    handleDamage()

        if self.damage.postVictimState != WMS.enums.lifeStates.ALIVE then 
            return 
        end

        self.damage.victim:SetHealth(self.damage.victim:Health() - self.damage.damage)
    
    end

    handleBrokenLimb()

        if !self.damage:getBreakLimb() then return end

        self.damage.victim:wmsBreakBone(self.damage:getArea())

    end

    handleBleeding()

        if !self.damage:getInitiatesBleeding() then return end

        self.damage.victim:wmsStartBleeding()

    end

    handleExplosion()

        if self.damage.type != WMS.enums.damageTypes.EXPLOSION then return end

        express.Send("WMSExplosionBlur", {""}, self.damage.victim)

    end

end
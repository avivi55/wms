-- local Tabular = include("wms/libs/tabular.lua")

public class Damage

    -- {CTakeDamageInfo} The data given by gmod each time an entity takes damage.
    originalCTDI = nil

    -- {Player} The victim of the damage.
    _get victim
    -- {Player | nil} The player which the damage originates.
    attacker = nil
    -- {Player | Entity} The entity that gave the damage or the attacker.
    inflictor = nil
    -- {Weapon | Entity} The weapon handled by the attacker at the moment of the damage.
    weapon = nil

    -- {number} The amount of damage
    _get damage

    -- {WMS.enums.damageTypes} The damage type.
    _get type  
    -- {WMS.enums.artificialDamageAreas} The custom area.
    _get area
    
    -- {WMS.enums.lifeStates} The state of the victim after the damage.
    _get postVictimState

    -- {boolean} Should the damage initiate bleeding.
    _get initiatesBleeding

    -- {boolean} Should the damage break the concerned limb.
    _get breakLimb

    constructor(damage: CTakeDamageInfo, victim: Player)

        self.originalCTDI = damage

        self.victim = victim
        self.hitgroup = self.victim:LastHitGroup()

        self.attacker = damage:GetAttacker()
        self.inflictor = damage:GetInflictor()

        if (IsValid(self.attacker) && self.attacker:IsPlayer()) then
            self.weapon = self.attacker:GetActiveWeapon()
        end

        self.damage = self.originalCTDI:GetDamage()
        self.postVictimState = WMS.enums.lifeStates.ALIVE
        self.initiatesBleeding = false

        self.type = self:getDamageType()

        self:handleWeapons()
        self:handleBleeding()
        self:handleOverdose()
        self:handleOrganFailure()

        self.breakLimb = self:shouldBreakLimb()

        if (self.hitgroup == HITGROUP_GENERIC) then 
            self.hitgroup = HITGROUP_CHEST
        end

        if (self.victim:Health() - self.damage <= 0) then 
            self.postVictimState = WMS.enums.lifeStates.PARTIAL_DEATH
        end

    end

    getDamageType()

        local damageTypes = WMS.enums.damageTypes

        -- it's ugly, blame lua for not having switch statements
        if (self:isFromBleeding())          then return damageTypes.BLEED 
        elseif (self:isFromVehicle())       then return damageTypes.VEHICLE 
        elseif (self:isFromFalling())       then return damageTypes.FALL 
        elseif (self:isFromProp())          then return damageTypes.PROP 
        elseif (self:isFromExplosion())     then return damageTypes.EXPLOSION 
        elseif (self:isFromFire())          then return damageTypes.FIRE 
        elseif (self:isFromOverdose())      then return damageTypes.OVERDOSE 
        elseif (self:isFromOrganFailure())  then return damageTypes.ORGAN_FAILURE 
        elseif (self:isFromPistol())        then return damageTypes.PISTOL 
        elseif (self:isFromRifle())         then return damageTypes.RIFLE 
        elseif (self:isFromMelee())         then return damageTypes.MELEE 
        end

        return damageTypes.UNRECOGNIZED

    end

    isFromVehicle()

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_CRUSH) != DMG_CRUSH) then return false end
        
        if (!IsValid(self.attacker)) then return false end
        if (!self.attacker:IsPlayer()) then return false end
        
        if (!self.attacker:InVehicle()) then return false end

        return true

    end

    isFromFalling()

        -- Don't know if they're the same. It's just for making sure.
        if (bit.band(self.originalCTDI:GetDamageType(), DMG_FALL) != DMG_FALL) then return false end
        if (!self.originalCTDI:IsFallDamage()) then return false end

        if (self.attacker:GetClass() != "worldspawn") then return false end

        return true

    end

    isFromProp()

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_CRUSH) != DMG_CRUSH) then return false end
        
        if (self.inflictor:GetClass() != "prop_physics") then return false end

        return true

    end

    isFromExplosion()

        if (!self.originalCTDI:IsExplosionDamage()) then return false end
        if (self.inflictor:GetClass() == "base_shell") then return true end
        if (string.StartsWith(self.inflictor:GetClass(), "cw_kk_ins2_projectile")) then return true end
        
        return true
        
    end

    isFromBleeding() 

        local DMG_BLEED = WMS.enums.newDamages.DMG_BLEED

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_BLEED) != DMG_BLEED) then return false end

        return true

    end

    isFromFire()

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_BURN) != DMG_BURN) then return false end

        return true

    end

    isFromOverdose()

        local DMG_OVERDOSE = WMS.enums.newDamages.DMG_OVERDOSE

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_OVERDOSE) != DMG_OVERDOSE) then return false end

        return true

    end

    isFromOrganFailure() 

        local DMG_ORGAN_FAILURE = WMS.enums.newDamages.DMG_ORGAN_FAILURE

        if (bit.band(self.originalCTDI:GetDamageType(), DMG_ORGAN_FAILURE) != DMG_ORGAN_FAILURE) then return false end

        return true

    end

    isFromWeapon()

        if (!self.weapon) then return false end
        if (!IsValid(self.weapon)) then return false end
        if (!self.weapon:IsWeapon()) then return false end
        
        if (!self.inflictor) then return false end
        if (!IsValid(self.inflictor)) then return false end

        return true

    end

    isFromMelee() 

        if (!self:isFromWeapon()) then return false end

        if (!WMS.weapons[WMS.enums.damageTypes.MELEE][self.weapon:GetClass()]) then return false end

        return true

    end

    isFromPistol() 

        if (!self:isFromWeapon()) then return false end

        if (!WMS.weapons[WMS.enums.damageTypes.PISTOL][self.weapon:GetClass()]) then return false end

        return true

    end

    isFromGredwitchEntity()

        if (self:isFromWeapon()) then return false end
        if (bit.band(self.originalCTDI:GetDamageType(), DMG_BULLET) != DMG_BULLET) then return false end
        if (!self.attacker:IsPlayer()) then return false end
        if (IsValid(self.inflictor)) then return false end

        return true

    end
    
    isFromRifle()

        if (self:isFromGredwitchEntity()) then return true end
        if (!self:isFromWeapon()) then return false end
        if (!WMS.weapons[WMS.enums.damageTypes.RIFLE][self.weapon:GetClass()]) then return false end

        return true

    end

    handleWeapons()

        if (self.type != WMS.enums.damageTypes.PISTOL
            && self.type != WMS.enums.damageTypes.RIFLE
            && self.type != WMS.enums.damageTypes.MELEE) 
        then
            return 
        end

        if (self.type == WMS.enums.damageTypes.MELEE) then self.hitgroup = WMS.utils.getRandomMelee() end

        local results = WMS.config.chances[self.hitgroup]:getResult(self:getDamageType())
        self.postVictimState = results.state
        self.damage = results.damage
        self.initiatesBleeding = results.bleeding

        if (results.area) then self.area = results.area end

    end

    handleBleeding()

        if (self.type != WMS.enums.damageTypes.BLEED) then return end

        self.damage = WMS.config.bleedingImportance

    end

    handleOverdose()

        if (self.type != WMS.enums.damageTypes.OVERDOSE) then return end

        self.damage = 0
        self.postVictimState = WMS.enums.lifeStates.PARTIAL_DEATH

    end

    handleOrganFailure()

        if (self.type != WMS.enums.damageTypes.ORGAN_FAILURE) then return end

        self.damage = 0
        self.postVictimState = WMS.enums.lifeStates.PARTIAL_DEATH

    end

    shouldBreakLimb()

        if (self.type == WMS.enums.damageTypes.PISTOL
            || self.type == WMS.enums.damageTypes.RIFLE
            || self.type == WMS.enums.damageTypes.MELEE) 
        then
            return WMS.utils.pourcentageCheck(WMS.config.fractureChanceWeapon)
        end
        
        if (self.type == WMS.enums.damageTypes.FALL) then
            return WMS.utils.pourcentageCheck(WMS.config.fractureChanceFall)
        end

    end

end
local Tabular = include("wms/libs/tabular.lua")


WMS ||= {}

WMS.utils = {}

WMS.utils.welcomeMessage = () =>
    MsgC(Color(255, 10, 10), "[WMS] INIT")
end

WMS.utils.shouldDrop = (weapon) =>

    local weapon_class = weapon:GetClass()

    if WMS.weapons[WMS.enums.damageTypes.RIFLE][weapon_class] then return true end
    if WMS.weapons[WMS.enums.damageTypes.PISTOL][weapon_class] && !WMS.weapons.oneArm[weapon_class] then
        return true
    end

    return false

end

WMS.utils.getRandomMelee = () =>
    local rn = math.random(100)

    local chancesSum = 0

    for hitgroup, chance in ipairs(WMS.config.chances.melee) do
        
        chancesSum += chance

        if (rn <= chancesSum) then
            return hitgroup
        end
        
    end 
end

WMS.utils.pourcentageCheck = (pourcentage) =>
    local rn = math.random(100)

    return rn <= pourcentage
end

WMS.utils.print = (...) =>

    for _, value of table.Pack(...) do

        if (type(value) == "table" && value.__tostring) then
            print(value)

            continue
        end


        if (type(value) == "table") then
            
            for _, v in ipairs(string.Split(Tabular(value), "\n")) do
                print(v)
            end

            continue
        end

        print(value)
        
    end

end
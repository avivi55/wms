WMS ||= {}

local PLAYER = FindMetaTable("Player")

function PLAYER:wmsInitTable()

    self.damages = {}
    self:wmsSyncDamages()

end

function PLAYER:wmsSyncDamages()

    if table.IsEmpty(self.damages) then return end

    if (SERVER) then
        express.Send("WMSSyncDamages", self.damages, self)
    end

end

if (CLIENT) then

    function PLAYER:wmsExplosionBlur()

        -- Explosion Ring
        LocalPlayer():SetDSP(32, false)
        
        -- Shock Muffle
        LocalPlayer():SetDSP(35, false)

        local startTime = SysTime()
        local time = 0

        local gaussian = (t, bl_time, peak) => 
            local mu = bl_time / 2
            local sigma = bl_time / 7.43
            return peak * math.exp(-((t - mu)^2) / (2 * sigma^2))
        end

        local polynomial = (t, bl_time, peak, coef) => 
            local p = bl_time / 2
            return peak * (1 - (((t - p)^(2*coef)) / (p^(2*coef))))
        end

        local combo = (bl_time, peak) => 

            local half_time = bl_time / 2

            -- lets dabble in functionnal programing :^) 
            return function(t)

                if t <= 0 then return 0 end

                if t < half_time then
                    return polynomial(t, bl_time, peak, 100)
                else
                    return gaussian(t, bl_time, peak)
                end

            end 

        end

        local brightness = combo(WMS.config.explosionBlurTime, -0.8)
        local redness = combo(WMS.config.explosionBlurTime, 5)
        local blur_delay = combo(WMS.config.explosionBlurTime, 0.1)

        hook.Add("RenderScreenspaceEffects", "WMS::ExplosionBlur", function()
            
            if !LocalPlayer():Alive() or startTime + WMS.config.explosionBlurTime <= SysTime() then return end

            local t = -startTime + time

            DrawColorModify({
                ["$pp_colour_addr"]         = 0,--(startTime - time + WMS.config.explosionBlurTime) / 5,
                ["$pp_colour_addg"]         = 0,
                ["$pp_colour_addb"]         = 0,
                ["$pp_colour_brightness"]   = brightness(t),
                ["$pp_colour_contrast"]     = 1,
                ["$pp_colour_colour"]       = 1,
                ["$pp_colour_mulr"]         = redness(t),
                ["$pp_colour_mulg"]         = 0,
                ["$pp_colour_mulb"]         = 0
            })

            DrawMotionBlur(0.7, 0.8, blur_delay(t)) 
            
            time = SysTime()
        end)

        timer.Simple(WMS.config.explosionBlurTime, function()
            hook.Remove("RenderScreenspaceEffects", "WMS::ExplosionBlur")
        end)

    end

    function PLAYER:wmsClearScreen() 

        self:wmsRemoveComaScreen()
        self:wmsRemoveDeathScreen()

    end
    
    function PLAYER:wmsPrintDeathScreen()

        hook.Add( "HUDPaint", "WMS::DEATH_SCREEN", function()
            
            local W, H = ScrW(), ScrH()
            
            surface.SetDrawColor(WMS.config.deathScreenColor)
            surface.DrawRect(0, 0, W, H)

            surface.SetTextColor(WMS.config.deathScreenTextColor)
            surface.SetFont("DEATH_SCREEN")
            local textWidth = surface.GetTextSize(WMS.config.deathScreenText)
            
            surface.SetTextPos((W / 2) - (textWidth / 2), H / 3)
            surface.DrawText(WMS.config.deathScreenText)

        end)

    end

    function PLAYER:wmsPrintComaScreen()

        hook.Add( "HUDPaint", "WMS::COMA_SCREEN", function()

            local W, H = ScrW(), ScrH()

            self:wmsPrintDeathScreen()

            surface.SetTextColor(WMS.config.deathScreenTextColor)
            surface.SetFont("DEATH_SCREEN_LITTLE")
            local textWidth = surface.GetTextSize(WMS.config.comaScreenText)

            surface.SetTextPos((W / 2) - (textWidth / 2), H / 1.5)
            surface.DrawText(WMS.config.comaScreenText)

        end)

    end

    function PLAYER:wmsRemoveComaScreen()
        hook.Remove("HUDPaint", "WMS::COMA_SCREEN")
        self:wmsRemoveDeathScreen()
    end

    function PLAYER:wmsRemoveDeathScreen()
        hook.Remove("HUDPaint", "WMS::DEATH_SCREEN")
    end

    express.Receive("WMSSyncDamages", function(data) 
        LocalPlayer().damages = data 
    end)
    
    express.Receive("WMSPrintComaScreen", function(data)
        LocalPlayer():wmsPrintComaScreen() 
    end)

    express.Receive("WMSPrintDeathScreen", function(data)
        LocalPlayer():wmsPrintDeathScreen() 
    end)

    express.Receive("WMSClearScreen", function(data)
        LocalPlayer():wmsClearScreen() 
    end)

    express.Receive("WMSExplosionBlur", function(data)
        LocalPlayer():wmsExplosionBlur() 
    end)

end

function PLAYER:wmsIsInComa()

    return timer.Exists("coma" .. self:EntIndex())

    -- for _, damage of self.damages do
    
    --     if (damage:getPostVictimState() == WMS.enums.lifeStates.PARTIAL_DEATH) then
    --         return true
    --     end

    -- end

    -- return false

end

function PLAYER:wmsIsBleeding()

    return timer.Exists("bleed" .. self:EntIndex())

    -- for _, damage of self.damages do
    
    --     if (damage:getInitiatesBleeding()) then
    --         return true
    --     end

    -- end

    -- return false

end

function PLAYER:wmsGetBrokenLimbs()

    local result = {}

    for _, damage of self.damages do
        result[damage.hitgroup] = damage:getBreakLimb()
    end

    return result

end

function PLAYER:wmsStartBleeding()

    if self:wmsIsBleeding() then return end

    timer.Create("bleed" .. self:EntIndex(), WMS.config.bleedingSpeed, 0, function()
    
        if !IsValid(self) or !self:Alive() then
            return
        end

        -- bleeding decal on player model
        local bone = self:GetBonePosition(math.random(1, self:GetBoneCount() - 1))
        if bone then
        
            local effect = EffectData()
            effect:SetOrigin(bone)
            util.Effect("BloodImpact", effect, true, true)
        
        end

        -- bleeding decals on the world
        local src = self:LocalToWorld(self:OBBCenter())
        for _ = 1, 12 do
        
            local dir = VectorRand() * self:GetModelRadius() * 1.4
            util.Decal("Blood", src - dir, src + dir)
        
        end

        -- we give the damage to the palyer
        local bleedingDamage = DamageInfo()
        bleedingDamage:SetDamageType(WMS.enums.newDamages.DMG_BLEED)
        self:TakeDamageInfo(bleedingDamage)
    end)

end

function PLAYER:wmsStopBleeding()

    timer.Remove("bleed" .. self:EntIndex())

end

function PLAYER:wmsBreakLeg()

    self:SetRunSpeed(WMS.config.fractureRunSpeed)
    self:SetWalkSpeed(WMS.config.fractureWalkSpeed)

    hook.Add("prone.CanExit", "WMS::PreventGettingUpBrokenLeg", function(player)
        return false
    end)

end

function PLAYER:wmsHealLeg()

    self:SetRunSpeed(WMS.config.defaultRunSpeed)
    self:SetWalkSpeed(WMS.config.defaultWalkSpeed)

    hook.Remove("prone.CanExit", "WMS::PreventGettingUpBrokenLeg")

end

function PLAYER:wmsBreakArm()

    hook.Add("PlayerSwitchWeapon", "WMS::BrokenArm", function(player, oldWeapon, newWeapon)


        if WMS.utils.shouldDrop(newWeapon) then
            self:DropWeapon(newWeapon)
            self:SwitchToDefaultWeapon()
            return true
        end

        return false

    end)

    local weapon = self:GetActiveWeapon()
    if WMS.utils.shouldDrop(weapon) then 
        self:DropWeapon(weapon)
        self:SwitchToDefaultWeapon()
    end

end

function PLAYER:wmsHealArm()

    hook.Remove("PlayerSwitchWeapon", "WMS::BrokenArm")

end

function PLAYER:wmsBreakBone(area: EnumField)

    if area == WMS.enums.artificialDamageAreas.LEG
    || area == WMS.enums.artificialDamageAreas.FOOT then

        self:wmsBreakLeg()
        return

    end

    if area == WMS.enums.artificialDamageAreas.HAND
    || area == WMS.enums.artificialDamageAreas.ARM then


        self:wmsBreakArm()
        return

    end

end

function PLAYER:wmsHealBone(area: EnumField)

    if area == WMS.enums.artificialDamageAreas.LEG
    || area == WMS.enums.artificialDamageAreas.FOOT then

        self:wmsHealLeg()
        return

    end

    if area == WMS.enums.artificialDamageAreas.HAND
    || area == WMS.enums.artificialDamageAreas.ARM then

        self:wmsHealArm()
        return

    end

end

function PLAYER:wmsStartComa()
    
    if self:wmsIsInComa() then return end

    express.Send("WMSPrintComaScreen", {""}, self)

    self:CreateRagdoll()
    self:StripWeapons()

    timer.Create("coma" .. self:EntIndex(), WMS.config.partialDeathTime, 1, function()
        self:wmsKill()
    end)

end

function PLAYER:wmsStopComa()

    if !self:wmsIsInComa() then return end

    timer.Remove("coma" .. self:EntIndex())

    express.Send("WMSClearScreen", {""}, self)

    self:Spawn()

    local rag = self:GetRagdollEntity()
    if IsValid(rag) then
        self:SetPos(rag?:GetPos())
    end

    for _, weapon in pairs(rag.Weapons) do
        self:Give(weapon)
    end

    for k, v in pairs(rag.ammo) do
        self:GiveAmmo(k, v)
    end

    self:SelectWeapon(rag.ActiveWeapon)

    self:SetHealth(15)

    hook.Add("prone.CanExit", "WMS::PreventGettingUpComa", function(player)

        if player:Health() >= WMS.config.unpronePostComaThreshold then

            -- the fact that this does not break anything is cazy
            hook.Remove("prone.CanExit", "WMS::PreventGettingUpComa")
            return true

        end

        return false

    end)

    prone.Enter(self)

end

function PLAYER:wmsKill()
    
    express.Send("WMSPrintDeathScreen", {""}, self)
    
    timer.Remove("coma"..self:EntIndex())
    
    self:wmsStopBleeding()

    self:Kill()

    self:wmsInitTable()

end

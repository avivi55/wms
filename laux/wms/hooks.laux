WMS ||= {}

import print from WMS.utils


hook.Add("PlayerSpawn", "WMS::Init", function(player, transition)

    print(`[WMS] Player Damage table initialized (${player:SteamID()})`)

    player:wmsSetup()
    player:wmsSyncDamages()

end)

hook.Add("EntityTakeDamage", "WMS::RegisterDamage", function(ply, dmg)

    if (! ply?:IsPlayer())then return true end

    local damage = Damage(dmg, ply)

    DamageApplier(damage):apply()
    ply.damages[#ply.damages] = damage
    
    ply:wmsSyncDamages()

    if WMS.DEBUG then
        print(ply.damages)
    end
    return true

end)


hook.Add("PlayerDisconnected", "WMS::ResetOnDisconnect", function(player)
    player.damages = nil
end)
